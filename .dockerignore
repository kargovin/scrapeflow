# Exclude everything except api/ and frontend/ (the only directories needed by the API image)
http-worker/
playwright-worker/
llm-worker/
mcp/
coordinator/
docker/
docs/
scripts/

# Secrets and env files
.env
secret.txt

# Git metadata
.git/
.gitignore
.gitattributes

# Markdown / docs
*.md
PRODUCTION_REVIEW.md
RESEARCH_NOTES.md
scrapeflow-session-handoff.md

# Frontend build artefacts and modules (built inside Docker by the node stage)
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Python caches
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
api/.ruff_cache/
